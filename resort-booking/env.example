# Copy to .env.local for local development (gitignored).
# On Netlify: Site settings → Environment variables (see NETLIFY DEPLOYMENT section below).

# ─── Supabase (required for live CMS / bookings sync) ───────────────────────

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Razorpay ───────────────────────────────────────────────────────────────

# Local dev: Razorpay is bypassed on localhost unless VITE_PAYMENT_DEMO_MODE=false
# Production (Netlify): leave VITE_PAYMENT_DEMO_MODE unset — real checkout is used

VITE_PAYMENT_DEMO_MODE=
PAYMENT_DEMO_MODE=

VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Razorpay test card: 4111 1111 1111 1111 · any future expiry · any CVV

# ─── App ────────────────────────────────────────────────────────────────────

VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=The Lonavala Stays

# ─── SMTP (booking emails — server-side only, no VITE_ prefix) ──────────────

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
ADMIN_EMAIL=your-email@gmail.com

# ═══════════════════════════════════════════════════════════════════════════
# NETLIFY DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Connect this Git repo to Netlify (New site → Import from Git).
#    The root netlify.toml sets base = "resort-booking" — do NOT change base
#    directory in the UI unless you remove that file.
#
# 2. Build settings (auto-detected from netlify.toml):
#      Build command:  npm run build
#      Publish dir:    dist
#      Functions dir:  netlify/functions
#      Node version:   20
#
# 3. Add these environment variables in Netlify → Site configuration →
#    Environment variables → Production (and Deploy previews if needed):
#
#    BUILD-TIME (baked into the frontend — must start with VITE_):
#      VITE_SUPABASE_URL
#      VITE_SUPABASE_ANON_KEY
#      VITE_RAZORPAY_KEY_ID          (public key, e.g. rzp_test_… or rzp_live_…)
#      VITE_APP_URL                  (your Netlify URL, e.g. https://lonavala-stays.netlify.app)
#      VITE_APP_NAME                 (optional, e.g. The Lonavala Stays)
#      Do NOT set VITE_PAYMENT_DEMO_MODE in production.
#
#    RUNTIME (Netlify Functions — secrets, no VITE_ prefix):
#      RAZORPAY_KEY_ID               (same as VITE_RAZORPAY_KEY_ID)
#      RAZORPAY_KEY_SECRET           (secret — Functions only)
#      MAIL_SERVER
#      MAIL_PORT
#      MAIL_USERNAME
#      MAIL_PASSWORD                 (Gmail app password — Functions only)
#      MAIL_DEFAULT_SENDER
#      ADMIN_EMAIL
#
# 4. After first deploy, in Supabase → Authentication → URL configuration:
#      Site URL: your Netlify production URL
#      Redirect URLs: add https://your-site.netlify.app/**
#
# 5. Test locally with functions:
#      cd resort-booking && npm run dev:netlify
#    Opens http://localhost:8888 (Vite + API redirects to functions).
#
# 6. Manual deploy (optional):
#      cd resort-booking && npm run build
#      npx netlify deploy --prod --dir=dist --functions=netlify/functions
